{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Nexus",
  "mainBinaryName": "agent-nexus",
  "identifier": "io.github.muxigame.agentnexus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "muxigame",
    "shortDescription": "Agent Nexus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh",
        "startMenuFolder": "Agent Nexus"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2RDVFNTQxQzRCNDNFMzkKUldRNVByVEVRZVhWSm5BK3FtUHgvUmhhSExJWUpYam45VUdlell6dEVWOHJheTh2SVJGSVJqY2EK",
      "endpoints": [
        "https://muxigame-prod-static-cn.oss-cn-hangzhou.aliyuncs.com/agent-nexus/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentnexus"
        ]
      }
    }
  }
}
